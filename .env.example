APP_NAME=FAXORA
DEPARTMENTS=DPS,SSG,SSI,FSI,CYBER
# development (default), test or production. production refuses SQLite, a missing SECRET_KEY and http:// APP_BASE_URL.
APP_ENV=development
SECRET_KEY=change-me
DATABASE_URL=sqlite:///instance/tracker.db
# Production (Azure Database for PostgreSQL): either a full DATABASE_URL, or these parts
# (the password then needs no URL escaping). PGSSLMODE defaults to require.
# PGHOST=faxora-prod-pg.postgres.database.azure.com
# PGUSER=faxoraadmin
# PGPASSWORD=
# PGDATABASE=faxora
APP_BASE_URL=http://localhost:5000
# Hours before a signed-in session ends
SESSION_HOURS=8

# Microsoft Entra ID sign-in (app registration from IT). Redirect URI: <APP_BASE_URL>/auth/callback
SSO_ENABLED=false
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# AZURE_REDIRECT_URI=https://faxora.example.com/auth/callback
# Read the department from the Microsoft profile at sign-in
SSO_READ_DEPARTMENT=true
# Username/password login. Set false at go-live; the break-glass usernames below can still use a password.
LOCAL_LOGIN_ENABLED=true
BREAK_GLASS_USERS=
SMTP_HOST=smtp.example.internal
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=facilitytrack-noreply@example.com
SMTP_USE_TLS=false
CATEGORY_MAILBOX_TRANSPORT=transport@example.com
CATEGORY_MAILBOX_SECURITY=security@example.com
CATEGORY_MAILBOX_HOUSEKEEPING=housekeeping@example.com
CATEGORY_MAILBOX_MAINTENANCE=maintenance@example.com
CATEGORY_MAILBOX_MEDICAL=medical@example.com
CATEGORY_MAILBOX_OTHERS=facilities@example.com
# SOS alerts go to all agents, the medical mailbox, and these extra addresses (comma-separated)
SOS_ALERT_EMAILS=security@example.com
EMERGENCY_NUMBERS=Emergency 112 · Ambulance 108
SEED_ADMIN_PASSWORD=
SEED_AGENT_PASSWORD=
SEED_EMPLOYEE_PASSWORD=
# Optional: email addresses for the seeded users (defaults: admin@, agent@, employee@example.com)
SEED_ADMIN_EMAIL=
SEED_AGENT_EMAIL=
SEED_EMPLOYEE_EMAIL=
